# CULTRAVEN — Environment Configuration (Monorepo Root)
# Set these in your Vercel project settings or local .env.local

# Public Storefront URL
NEXT_PUBLIC_SITE_URL=https://cultraven.com

# Backend API URL (Optional — defaults to mock fixtures if unreachable)
NEXT_PUBLIC_API_URL=https://api.cultraven.com/api/v1

# Razorpay Key (Optional during drop preview)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# Microservice URLs (Optional)
CATALOG_SERVICE_URL=http://localhost:4003/api/v1
CMS_SERVICE_URL=http://localhost:4005/api/v1
