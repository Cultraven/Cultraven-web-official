{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_RAZORPAY_KEY_ID",
        "CATALOG_SERVICE_URL",
        "CMS_SERVICE_URL",
        "NODE_ENV"
      ]
    },
    "dev": { "cache": false, "persistent": true },
    "typecheck": {},
    "test": {}
  }
}
