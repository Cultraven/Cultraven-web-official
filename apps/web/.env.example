# CULTRAVEN — Environment Configuration
# Copy this file to .env.local for local development or set in Vercel project settings.

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://cultraven.com

# Backend API URL (Optional in frontend-only / static drop mode)
NEXT_PUBLIC_API_URL=https://api.cultraven.com/api/v1

# Razorpay Key (Optional during Coming Soon phase)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# Microservice URLs (Optional — defaults to built-in mock fixtures if unreachable)
CATALOG_SERVICE_URL=http://localhost:4003/api/v1
CMS_SERVICE_URL=http://localhost:4005/api/v1
