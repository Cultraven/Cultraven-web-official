# ─────────────────────────────────────────────────────────────────────────────
# CULTRAVEN Storefront — Environment Variables
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Next.js ──────────────────────────────────────────────────────────────────
# The canonical URL of your site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://cultraven.com

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (keep secret — server-only)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cultraven?retryWrites=true&w=majority

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Key ID is safe to expose to browser (NEXT_PUBLIC_)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXXX
# Secret key — server-side only, NEVER prefix with NEXT_PUBLIC_
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
# Webhook secret — set this in Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── Authentication ───────────────────────────────────────────────────────────
# Secret used to sign session tokens (generate with: openssl rand -base64 32)
SESSION_SECRET=your_super_secret_session_key_here_min_32_chars
# Admin panel password (plain text — hashed via timingSafeEqual on server)
ADMIN_PASSWORD=your_admin_password_here
# Random token stored in admin cookie and verified by middleware
# Generate with: openssl rand -hex 32
ADMIN_SECRET_TOKEN=your_random_admin_secret_token_here

# ── Backend Services ─────────────────────────────────────────────────────────
# Auth / User service (handles login, register, forgot-password)
AUTH_SERVICE_URL=http://localhost:4001/api/v1
# Catalog / Products service
CATALOG_SERVICE_URL=http://localhost:4003/api/v1
# CMS service
CMS_SERVICE_URL=http://localhost:4005/api/v1
# General API base URL (used by lib/api.ts)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ── Analytics ────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Meta Pixel ID (optional)
NEXT_PUBLIC_META_PIXEL_ID=

# ── Storage ──────────────────────────────────────────────────────────────────
# Google Cloud Storage bucket for product/hero images
STORAGE_BUCKET=cultraven-media

# ── WhatsApp ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/cultraven

# ── Newsletter (optional — use Resend, Mailchimp, etc.) ─────────────────────
NEWSLETTER_LIST_ID=
RESEND_API_KEY=
