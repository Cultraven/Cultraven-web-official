# ─────────────────────────────────────────────────────────────────────────────
# CULTRAVEN Storefront — Main Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── Next.js ──────────────────────────────────────────────────────────────────
# The canonical URL of your site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/cultraven

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Razorpay Dashboard → Settings → API Keys. Leave blank until you have keys: online payment then
# reports "not available" and Cash on Delivery keeps working.
# Key ID is safe to expose to the browser (NEXT_PUBLIC_)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# Same key id for the server (optional - falls back to the public one)
RAZORPAY_KEY_ID=
# Secret key — server-side only, NEVER prefix with NEXT_PUBLIC_
RAZORPAY_KEY_SECRET=
# Webhook secret — set this in Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=

# ── Authentication ───────────────────────────────────────────────────────────
# Secret used to sign session tokens (generate with: openssl rand -base64 32)
SESSION_SECRET=
# Admin panel credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Random token stored in admin cookie and verified by middleware
ADMIN_SECRET_TOKEN=

# ── Backend Services ─────────────────────────────────────────────────────────
# Auth / User service (handles login, register, forgot-password)
AUTH_SERVICE_URL=http://localhost:4001/api/v1
# Catalog / Products service
CATALOG_SERVICE_URL=http://localhost:4003/api/v1
# CMS service
CMS_SERVICE_URL=http://localhost:4005/api/v1
# General API base URL (used by lib/api.ts)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ── Analytics ────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Meta Pixel ID (optional)
NEXT_PUBLIC_META_PIXEL_ID=

# ── Storage ──────────────────────────────────────────────────────────────────
# Google Cloud Storage bucket for product/hero images
STORAGE_BUCKET=cultraven-media

# ── WhatsApp ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
# Shown on the Help Center / Contact us. Optional: leave the phone blank to hide the "Call us" option.
NEXT_PUBLIC_SUPPORT_EMAIL=support@cultraven.com
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_HOURS=Mon-Sat, 10 AM - 7 PM IST
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/cultraven

# ── Newsletter (optional — use Resend, Mailchimp, etc.) ─────────────────────
NEWSLETTER_LIST_ID=
RESEND_API_KEY=
